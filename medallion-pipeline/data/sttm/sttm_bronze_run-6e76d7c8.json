{
  "phase": "bronze",
  "business_intent": "What is the major revenue generating product and location",
  "objectives": [
    "Create a unified sales fact table that joins sales_data, products, and stores on product_id and store_id.",
    "Normalize product_name and category to ensure consistency across source files.",
    "Generate a revenue metric per product and location (store) for downstream reporting.",
    "Enforce data type consistency: convert transaction_date to date, quantity to integer, prices to float.",
    "Add a surrogate key for each transaction to support incremental loads.",
    "Record source metadata (file name, ingestion timestamp) for auditability."
  ],
  "rules": [
    {
      "source_file": "products.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim and title\u2011case to match sales_data"
    },
    {
      "source_file": "products.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products.csv",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "parse string to DATE using format 'YYYY-MM-DD'"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "cast_integer"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "calculate as quantity * unit_price if null or inconsistent with source"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "normalize case (title\u2011case) to match sales_data store references"
    },
    {
      "source_file": "stores.csv",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "All source files contain no nulls, so null handling is not required.",
    "product_name and category appear in both products.csv and sales_data.csv; potential mismatch must be reconciled.",
    "sales_data.unit_price may differ from products.standard_price; decide which to trust or store both.",
    "transaction_date is a string; needs parsing to ISO date format.",
    "store_id in sales_data and stores.csv are both strings; ensure no leading/trailing spaces.",
    "row counts are small, enabling full table joins without partitioning."
  ]
}
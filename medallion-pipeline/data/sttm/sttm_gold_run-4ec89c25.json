{
  "phase": "gold",
  "business_intent": "waht is the top 5 most revanue and profitable product",
  "objectives": [
    "Compute total revenue per product by aggregating total_amount from sales_data_silver.",
    "Compute total units sold per product by summing quantity from sales_data_silver.",
    "Calculate average unit price per product by averaging unit_price from sales_data_silver.",
    "Determine gross profit per product by subtracting standard_price * quantity from total_amount.",
    "Rank products by revenue and profit to identify top 5 performers.",
    "Create a dimension table that links product_id, product_name, category, and store-level context for drill\u2011down analysis."
  ],
  "rules": [
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "COALESCE(standard_price, 0) AS standard_price"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "datetime",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "product_id AS product_id"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "COALESCE(quantity, 0) AS quantity"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "COALESCE(unit_price, 0) AS unit_price"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "COALESCE(total_amount, 0) AS total_amount"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "keep"
    }
  ],
  "notes": [
    "Perform a many\u2011to\u2011one join of sales_data_silver to products_silver on product_id to enrich sales rows with product metadata.",
    "Use window functions (DENSE_RANK) on aggregated revenue and profit to capture ties in the top\u20115 list.",
    "Apply NULL\u2011safety checks: if total_amount or quantity is NULL, treat it as 0 to avoid skewed aggregates.",
    "Store the resulting KPI columns in a single fact table for fast lookups by downstream BI tools.",
    "Materialize the fact table as a partitioned Parquet file on product_id to optimize query performance."
  ]
}
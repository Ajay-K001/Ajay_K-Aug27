          "left_file": "joined_sales_products",
          "right_file": "stores_bronze.parquet",
          "on": [
            "store_id"
          ],
          "type": "inner",
          "columns_to_select": [
            "transaction_id",
            "transaction_date",
            "store_id",
            "store_name",
            "region",
            "city",
            "state",
            "product_id",
            "product_name",
            "category",
            "quantity",
            "unit_price",
            "total_amount",
            "customer_segment",
            "payment_method"
          ]
        },

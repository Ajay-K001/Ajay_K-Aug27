{
  "phase": "silver",
  "business_intent": "waht is the product generated more revanue",
  "objectives": [
    "Remove duplicate rows from sales_data_bronze.parquet based on transaction_id.",
    "Standardise transaction_date to ISO 8601 date format (YYYY\u2011MM\u2011DD).",
    "Cast quantity to integer and unit_price, total_amount to double precision.",
    "Handle null store_id values by replacing them with a placeholder 'UNKNOWN_STORE'.",
    "Normalize product_name and category strings to title case and trim whitespace.",
    "Enrich sales records with product standard_price from products_bronze.parquet for revenue calculations."
  ],
  "rules": [
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "to_date(transaction_date, 'MM/dd/yyyy')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "coalesce(store_id, 'UNKNOWN_STORE')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "initcap(trim(product_name))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "initcap(trim(category))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "cast_integer"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "sales_data_bronze has 13 missing store_id entries out of 500 rows.",
    "All parquet files contain no duplicate rows except sales_data_bronze, which requires deduplication.",
    "transaction_date is stored as string; parsing is required to enable date\u2011based analytics.",
    "No nulls in product_id, product_name, or category across datasets.",
    "Standard_price is always present in products_bronze, enabling revenue validation."
  ]
}
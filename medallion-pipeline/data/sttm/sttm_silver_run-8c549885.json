    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "coalesce(store_id, 'UNKNOWN_STORE')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_id",

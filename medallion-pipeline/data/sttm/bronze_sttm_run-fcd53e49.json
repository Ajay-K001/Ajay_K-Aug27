          },
          {
            "description": "Create surrogate key for products",
            "rule": "Generate a UUID for each distinct product_id if not already unique."
          },
          {
            "description": "Derive revenue metrics",
            "rule": "Add columns: revenue = unit_price * quantity, margin = total_amount - standard_price * quantity."
          },
          {
            "description": "Detect duplicate transactions",
            "rule": "Flag rows with duplicate transaction_id within the same file."
          }
        ],
        "quality_checks": [
          {
            "check": "Non\u2011null primary key",
            "columns": [
              "product_id",

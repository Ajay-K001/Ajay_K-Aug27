{
  "phase": "gold",
  "business_intent": "Which product generating more income ?",
  "objectives": [
    "Calculate total revenue per product (sum of total_amount) and rank products by revenue.",
    "Compute average unit price per product and per category to detect pricing anomalies.",
    "Derive revenue contribution per customer segment and payment method for each product.",
    "Aggregate revenue by store location (region, city, state) to identify high\u2011performing regions.",
    "Create a time\u2011based view (monthly/quarterly) of product revenue to spot trends.",
    "Generate a KPI table that stores pre\u2011aggregated metrics for quick reporting (e.g., product_id, product_name, category, total_revenue, avg_unit_price, revenue_rank)."
  ],
  "rules": [
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "SUM(standard_price)"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "datetime",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "SUM(quantity) AS total_quantity_sold"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "AVG(unit_price) AS avg_unit_price"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "SUM(total_amount) AS total_revenue"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "SUM(total_amount) AS revenue_by_segment"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "COUNT(DISTINCT store_id) AS distinct_store_count"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "keep"
    }
  ],
  "notes": [
    "Use the `product_id` as the primary key for joins between `products_silver.parquet` and `sales_data_silver.parquet`.",
    "Ensure that the `total_amount` column is used exclusively for revenue calculations; avoid double\u2011counting by filtering out any null or negative values.",
    "Leverage Spark SQL window functions to compute `revenue_rank` per product without materializing large intermediate datasets.",
    "Store the final KPI table in Parquet format with partitioning on `category` and `region` to accelerate downstream analytics.",
    "Maintain a versioning strategy (e.g., `effective_date` column) so that incremental loads can be merged without data duplication."
  ]
}
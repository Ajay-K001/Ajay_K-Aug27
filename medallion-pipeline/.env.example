# Choose one provider: groq, gemini, openai, or github
LLM_PROVIDER=groq

# Get your Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to llama-3.3-70b-versatile.
# Candidate model: openai/gpt-oss-20b
# Candidate model: openai/gpt-oss-120b
# Candidate model: llama-3.1-8b-instant
# Candidate model: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Get your Google Gemini API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Get your OpenAI API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Get your GitHub token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Defaults to openai/gpt-4.1-mini.
GITHUB_MODEL=openai/gpt-4.1-mini

{
  "phase": "silver",
  "business_intent": "what is the top 5 profitable prduct",
  "objectives": [
    "Remove duplicate rows from sales_data_bronze.parquet based on transaction_id.",
    "Standardise product_id values across all tables to ensure consistent key format.",
    "Parse transaction_date strings into proper timestamp datatype.",
    "Cast store_id in sales_data_bronze.parquet to string and fill missing values with a placeholder.",
    "Trim and convert product_name and category fields to title case for uniformity.",
    "Validate that total_amount equals quantity * unit_price; flag discrepancies for review."

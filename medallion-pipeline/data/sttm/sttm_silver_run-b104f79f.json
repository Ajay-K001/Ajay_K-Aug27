{
  "phase": "silver",
  "business_intent": "what is the top 10 profitable product",
  "objectives": [
    "Remove duplicate sales transactions using transaction_id and product_id combination.",
    "Standardise transaction_date to ISO 8601 date format (yyyy\u2011MM\u2011dd).",
    "Cast quantity to long and unit_price, total_amount to decimal(10,2).",
    "Trim whitespace and convert product_name, category, customer_segment, payment_method to title case.",
    "Replace missing store_id values with a sentinel value 'UNKNOWN' and flag them for downstream review.",
    "Enrich sales records with product standard_price from products_bronze and compute profit = total_amount - (quantity * standard_price)."
  ],
  "rules": [
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "TO_DATE(transaction_date, 'yyyy-MM-dd')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "COALESCE(store_id, 'UNKNOWN')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "INITCAP(TRIM(product_name))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "INITCAP(TRIM(category))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "CAST(quantity AS BIGINT)"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "CAST(unit_price AS DECIMAL(10,2))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "CAST(total_amount AS DECIMAL(10,2))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "INITCAP(TRIM(customer_segment))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "INITCAP(TRIM(payment_method))"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "sales_data_bronze contains 2 duplicate rows that must be eliminated.",
    "store_id has 6 nulls; these represent missing store references and need a default.",
    "transaction_date is stored as string; proper parsing is required for analytics.",
    "unit_price and total_amount are floats; precision loss may occur without decimal casting.",
    "String fields contain leading/trailing spaces and inconsistent casing."
  ]
}
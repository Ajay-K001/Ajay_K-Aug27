{
  "phase": "silver",
  "business_intent": "what is the most profitable product",
  "objectives": [
    "Remove duplicate sales transactions based on transaction_id, keeping the first occurrence.",
    "Standardize transaction_date to ISO 8601 date format (YYYY\u2011MM\u2011DD) and cast to DateType.",
    "Normalize product_name and category strings by trimming whitespace, converting to title case, and removing leading/trailing punctuation.",
    "Coalesce missing store_id values in sales data by joining with stores_bronze and filling with the most frequent store_id per region.",
    "Convert unit_price and total_amount to DecimalType(10,2) to avoid floating point inaccuracies.",
    "Enforce non\u2011null constraints on key columns (product_id, transaction_id, transaction_date) and drop rows where any of these are missing."
  ],
  "rules": [
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "initcap(trim(product_name))"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "initcap(trim(category))"
    },
    {
      "source_file": "products_bronze.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "to_date(trim(transaction_date), 'yyyy-MM-dd')"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "initcap(trim(product_name))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "initcap(trim(category))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "cast_integer"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "cast(unit_price as Decimal(10,2))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "cast(total_amount as Decimal(10,2))"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data_bronze.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores_bronze.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "sales_data_bronze contains 2 duplicate transaction_ids; these will be removed.",
    "6 out of 54 sales rows have null store_id; they will be imputed via a lookup to stores_bronze.",
    "All dates are stored as strings; they require parsing to proper DateType.",
    "String columns (product_name, category, customer_segment, payment_method) contain inconsistent casing and whitespace.",
    "Standard_price in products_bronze is already float but will be cast to Decimal for consistency."
  ]
}
              "name": "year",
              "expression": "year(transaction_date)"
            },
            {
              "name": "sales_amount",
              "expression": "total_amount"
            }
          ]
        },
        {
          "operation": "aggregate",
          "group_by": [
            "year",
            "product_id",
            "product_name",
            "store_id",
            "store_name",
            "region"
          ],
          "aggregations": [
            {
              "column": "sales_amount",
              "function": "sum",
              "alias": "annual_sales"
            },
            {
              "column": "quantity",
              "function": "sum",
              "alias": "annual_quantity"
            }
          ]
        }
      ],

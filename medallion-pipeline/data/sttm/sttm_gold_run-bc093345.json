{
  "phase": "gold",
  "business_intent": "",
  "objectives": [
    "Compute total revenue per product category per store region.",
    "Calculate average unit price and average quantity sold per product category.",
    "Determine store-level sales performance metrics: total sales, average transaction value, and transaction count.",
    "Generate customer segment revenue breakdowns across all stores.",
    "Create a KPI table that aggregates key performance indicators at the product, store, and region levels.",
    "Provide time\u2011based revenue trends (month\u2011over\u2011month growth) for each product category."
  ],
  "rules": [
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "SUM(standard_price)"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "COUNT(DISTINCT transaction_id) AS transaction_count"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "datetime",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "AVG(quantity) AS avg_quantity_sold"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "AVG(unit_price) AS avg_unit_price"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "SUM(total_amount) AS total_revenue"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "COUNT(store_id) AS store_count"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "keep"
    }
  ],
  "notes": [
    "Use dimensional joins on product_id, store_id, and category to preserve the star\u2011schema structure.",
    "Apply window functions to compute month\u2011over\u2011month growth while avoiding data skew from small partitions.",
    "Leverage approximate count distinct for customer segments to keep the Gold layer lightweight.",
    "Store the aggregated metrics in a columnar format with partitioning on region and month for fast slice\u2011and\u2011dice queries.",
    "Ensure the Gold layer is refreshed incrementally using watermarking on the transaction timestamp."
  ]
}
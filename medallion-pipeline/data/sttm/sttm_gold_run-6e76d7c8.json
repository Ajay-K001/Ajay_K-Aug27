{
  "phase": "gold",
  "business_intent": "What is the major revenue generating product and location",
  "objectives": [
    "Identify the product with the highest total revenue across all stores.",
    "Determine the store location (region/city/state) that generated the highest total revenue.",
    "Compute total revenue, total quantity sold, and average unit price per product category.",
    "Calculate revenue contribution of each product within its category.",
    "Generate a KPI table that includes: product_id, product_name, category, store_id, store_name, region, city, state, total_revenue, total_quantity, average_unit_price, revenue_rank_by_product, revenue_rank_by_location."
  ],
  "rules": [
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "products_silver.parquet",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "SUM(standard_price)"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "datetime",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "COUNT(quantity)"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "SUM(unit_price)"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "IF total_amount IS NULL THEN quantity * unit_price ELSE total_amount END"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data_silver.parquet",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "GROUP_BY"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores_silver.parquet",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "keep"
    }
  ],
  "notes": [
    "Use dimension joins: join sales_data_silver with products_silver on product_id, and with stores_silver on store_id to enrich sales records with product and store attributes.",
    "Aggregate revenue as sum(total_amount) per product and per location; ensure total_amount is correctly calculated as quantity * unit_price if not pre\u2011aggregated.",
    "Apply window functions to rank products and locations by revenue; use dense_rank to handle ties.",
    "Normalize numeric columns: convert all monetary values to a common currency if necessary before aggregation.",
    "Include a date dimension if present in sales data for time\u2011series extensions; otherwise, keep the current snapshot."
  ]
}
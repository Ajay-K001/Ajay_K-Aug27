{
  "phase": "bronze",
  "business_intent": "",
  "objectives": [
    "Ingest raw CSV files into Bronze tables with original schema",
    "Preserve nullability and data types as defined in source metadata",
    "Validate mandatory key columns (e.g., product_id, transaction_id, store_id)",
    "Enforce referential integrity between sales_data and products/stores via foreign keys",
    "Record ingestion timestamps and source file metadata for lineage",
    "Generate a unified view for downstream Silver processing"
  ],
  "rules": [
    {
      "source_file": "products.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products.csv",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "round(standard_price, 2)"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "to_date(transaction_date, 'yyyy-MM-dd')"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "cast_integer"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "quantity * unit_price"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "products.csv has no nulls but standard_price should be rounded to 2 decimals",
    "sales_data.csv has 1 null store_id; treat as optional foreign key",
    "transaction_date is string; convert to ISO 8601 date format",
    "total_amount should be validated as quantity * unit_price to catch data entry errors"
  ]
}
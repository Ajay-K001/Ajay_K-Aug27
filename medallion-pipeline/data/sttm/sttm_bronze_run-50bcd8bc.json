{
  "phase": "bronze",
  "business_intent": "Which product is generating more revenue and location",
  "objectives": [
    "Validate that every sales transaction references a valid product_id and store_id.",
    "Convert transaction_date from string to ISO 8601 datetime.",
    "Recalculate total_amount as quantity * unit_price to catch discrepancies.",
    "Normalize product_name and category to match the master product list.",
    "Enrich sales records with region, city, and state via store lookup.",
    "Aggregate revenue per product and location for downstream reporting."
  ],
  "rules": [
    {
      "source_file": "products.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "products.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "products.csv",
      "source_column": "standard_price",
      "target_column": "standard_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_id",
      "target_column": "transaction_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "transaction_date",
      "target_column": "transaction_date",
      "data_type": "string",
      "transformation_logic": "parse to datetime with format 'YYYY-MM-DD'; if fails, flag record."
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_id",
      "target_column": "product_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "product_name",
      "target_column": "product_name",
      "data_type": "string",
      "transformation_logic": "trim whitespace and title-case; ensure consistency with products.csv."
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "category",
      "target_column": "category",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "quantity",
      "target_column": "quantity",
      "data_type": "integer",
      "transformation_logic": "cast_integer"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "unit_price",
      "target_column": "unit_price",
      "data_type": "float",
      "transformation_logic": "cast_float"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "total_amount",
      "target_column": "total_amount",
      "data_type": "float",
      "transformation_logic": "recompute as quantity * unit_price; if difference > 0.01, flag discrepancy."
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "customer_segment",
      "target_column": "customer_segment",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "sales_data.csv",
      "source_column": "payment_method",
      "target_column": "payment_method",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_id",
      "target_column": "store_id",
      "data_type": "string",
      "transformation_logic": "keep"
    },
    {
      "source_file": "stores.csv",
      "source_column": "store_name",
      "target_column": "store_name",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "region",
      "target_column": "region",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "city",
      "target_column": "city",
      "data_type": "string",
      "transformation_logic": "trim"
    },
    {
      "source_file": "stores.csv",
      "source_column": "state",
      "target_column": "state",
      "data_type": "string",
      "transformation_logic": "trim"
    }
  ],
  "notes": [
    "All source files contain no nulls; data is fully populated.",
    "product_id and store_id are strings but may include leading zeros; preserve as string.",
    "transaction_date format is ambiguous; assume YYYY-MM-DD but validate on ingestion.",
    "sales_data includes both product_name and category; they should align with products.csv.",
    "unit_price and standard_price may differ due to discounts; keep both for audit."
  ]
}